# Copy to an ignored local .env only if no .env already exists.
# Generate a unique secret securely; never commit real credentials.
DEBUG=False
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HTTPS=False

# Required for production. Source uses separate PostgreSQL fields.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
REDIS_URL=

# Real email delivery is required to exercise verification/recovery outside tests.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=

# Optional discovery and directions integrations; use restricted separate keys.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_ROUTES_API_KEY=
PLACES_DAILY_REQUEST_LIMIT=1000
PLACES_MINUTE_REQUEST_LIMIT=60
ROUTES_DAILY_REQUEST_LIMIT=500
ROUTES_MINUTE_REQUEST_LIMIT=30
