# Copy to an ignored local .env only if no .env already exists.
# Generate a unique secret securely; never commit real credentials.
DEBUG=False
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HTTPS=False

# Required for production. Source uses separate PostgreSQL fields.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
REDIS_URL=

# Optional fresh installation only. These commands never import old member/PPA data.
# Location initialization creates public reference choices, not PPA listings.
PPA_INITIALIZE_LOCATIONS=False
# Enable only to create the first operator account in an empty user table.
# Use a unique password of at least 12 characters; never commit actual values.
PPA_BOOTSTRAP_ADMIN=False
PPA_ADMIN_STATE_CODE=
PPA_ADMIN_EMAIL=
PPA_ADMIN_FULL_NAME=
PPA_ADMIN_PASSWORD=

# Real email delivery is required to exercise verification/recovery outside tests.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=

# Optional discovery and directions integrations; use restricted separate keys.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_ROUTES_API_KEY=
PLACES_DAILY_REQUEST_LIMIT=1000
PLACES_MINUTE_REQUEST_LIMIT=60
ROUTES_DAILY_REQUEST_LIMIT=500
ROUTES_MINUTE_REQUEST_LIMIT=30

# Private chat photos. Off in production until a durable private bucket is ready.
# Never use a public bucket, static-file directory, or ephemeral service disk.
PPA_PHOTOS_ENABLED=False
PPA_PHOTO_STORAGE_BACKEND=s3
PPA_PHOTO_BUCKET=
PPA_PHOTO_S3_REGION=us-east-1
# Optional HTTPS endpoint for an S3-compatible provider.
PPA_PHOTO_S3_ENDPOINT_URL=
# Set both in protected hosting settings, or use an operator-managed IAM role.
PPA_PHOTO_S3_ACCESS_KEY_ID=
PPA_PHOTO_S3_SECRET_ACCESS_KEY=
# Development only: filesystem backend plus an absolute private directory.
# PPA_PHOTO_STORAGE_ROOT=
